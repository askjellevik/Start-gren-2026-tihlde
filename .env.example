# Kopier til .env.local og fyll inn verdier.
#
# Lokalt: kjør `npx supabase start` og bruk URL/ANON_KEY fra `npx supabase status`.
# Produksjon: Supabase-dashboardet (Project Settings -> API). Legg de samme inn i Vercel.
#
# Uten disse kjører kalkulatoren på det innebygde datasettet (adminpanelet er da av).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
